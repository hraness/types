{
  "name": "@hraness/types",
  "version": "0.1.1",
  "description": "A small TypeScript utility-type foundation.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/types.git"
  },
  "homepage": "https://github.com/hraness/types#readme",
  "bugs": {
    "url": "https://github.com/hraness/types/issues"
  },
  "keywords": [
    "typescript",
    "types",
    "utility-types",
    "type-fest",
    "ts-reset"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts"
    },
    "./reset": {
      "types": "./src/reset.d.ts"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src/index.d.ts",
    "src/reset.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "test:package": "bun run ./scripts/package-smoke.ts",
    "check": "bun run typecheck && bun run test:package && bun run test",
    "prepack": "bun run check"
  },
  "dependencies": {
    "@total-typescript/ts-reset": "^0.6.1",
    "type-fest": "^5.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
