{
  "name": "@hraness/types",
  "version": "0.1.1",
  "description": "Declaration-only TypeScript types: the type-fest surface, a readonly NonEmptyArray, and an opt-in ts-reset entrypoint.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/types.git"
  },
  "homepage": "https://github.com/hraness/types#readme",
  "bugs": {
    "url": "https://github.com/hraness/types/issues"
  },
  "keywords": [
    "typescript",
    "types",
    "utility-types",
    "type-fest",
    "ts-reset"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts"
    },
    "./reset": {
      "types": "./src/reset.d.ts"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src/index.d.ts",
    "src/reset.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "test:package": "bun run ./scripts/package-smoke.ts",
    "kb:refresh": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell refresh --root kb",
    "kb:check:lane": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell check --root kb --no-catalog",
    "kb:check": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell check --root kb && bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell agents check --root kb --repo .",
    "kb:catalog": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell catalog --root kb",
    "kb:search": "HRANESS_NO_UPDATE=1 wordcell search --root kb --mode exact --selected-passage",
    "kb:search:local": "HRANESS_NO_UPDATE=1 wordcell search --root kb --mode exact --selected-passage",
    "check": "bun run typecheck && bun run test:package && bun run test",
    "prepack": "bun run check"
  },
  "dependencies": {
    "@total-typescript/ts-reset": "^0.6.1",
    "type-fest": "^5.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
